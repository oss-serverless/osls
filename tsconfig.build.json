{
  // Builds the published package into `dist/` (see scripts/build.ts)
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "types": ["node"]
  },
  "include": ["bin/**/*.ts", "commands/**/*.ts", "lib/**/*.ts", "scripts/serverless.ts"],
  "exclude": ["dist", "node_modules"]
}

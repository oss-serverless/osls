{
  "name": "osls",
  "version": "4.0.0-dev",
  "private": true,
  "description": "osls CLI for deploying serverless applications",
  "type": "module",
  "preferGlobal": true,
  "homepage": "https://github.com/oss-serverless/osls",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oss-serverless/osls.git"
  },
  "keywords": [
    "serverless",
    "lambda",
    "aws",
    "amazon",
    "azure",
    "google-cloud",
    "apache-open-whisk",
    "iot"
  ],
  "main": "lib/serverless.ts",
  "types": "types/index.d.ts",
  "bin": {
    "serverless": "bin/serverless.ts",
    "sls": "bin/serverless.ts",
    "osls": "bin/serverless.ts"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^15.3.5",
    "@aws-sdk/client-api-gateway": "^3.1077.0",
    "@aws-sdk/client-apigatewayv2": "^3.1077.0",
    "@aws-sdk/client-cloudformation": "^3.1077.0",
    "@aws-sdk/client-cloudwatch": "^3.1077.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1077.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1077.0",
    "@aws-sdk/client-ecr": "^3.1077.0",
    "@aws-sdk/client-eventbridge": "^3.1077.0",
    "@aws-sdk/client-iam": "^3.1077.0",
    "@aws-sdk/client-lambda": "^3.1077.0",
    "@aws-sdk/client-s3": "^3.1077.0",
    "@aws-sdk/client-ssm": "^3.1077.0",
    "@aws-sdk/client-sso-oidc": "^3.1077.0",
    "@aws-sdk/client-sts": "^3.1077.0",
    "@aws-sdk/credential-providers": "^3.1077.0",
    "@aws-sdk/lib-storage": "^3.1077.0",
    "@smithy/core": "^3.28.0",
    "@smithy/node-http-handler": "^4.9.1",
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1",
    "content-disposition": "^2.0.1",
    "cross-spawn": "^7.0.6",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^13.0.0",
    "ext": "^1.7.0",
    "fast-glob": "^3.3.3",
    "fastest-levenshtein": "^1.0.16",
    "filenamify": "^7.0.1",
    "https-proxy-agent": "^9.0.0",
    "js-yaml": "^4.3.0",
    "json-cycle": "^1.5.0",
    "log": "^6.3.1",
    "log-node": "^8.0.3",
    "memoizee": "^0.4.15",
    "micromatch": "^4.0.5",
    "mime-types": "^3.0.2",
    "semver": "^7.5.3",
    "signal-exit": "^4.1.0",
    "tsx": "^4.23.15",
    "type": "^2.7.2",
    "undici": "^7.25.0",
    "write-file-atomic": "^7.0.1",
    "yauzl": "^3.3.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/sinon": "^22.0.2",
    "@types/sinon-chai": "^4.0.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "adm-zip": "^0.5.10",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-n": "^18.1.0",
    "esmock": "^2.8.0",
    "git-list-updated": "^1.2.1",
    "globals": "^17.5.0",
    "jiti": "^2.7.0",
    "jszip": "^3.10.1",
    "mocha": "12.0.0-rc.1",
    "prettier": "^3.8.3",
    "sinon": "^22.0.0",
    "sinon-chai": "^4.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "docs-check": "node scripts/check-docs-coverage.ts",
    "integration-test-run-package": "mocha --config test/mocha/config.json \"test/integration-package/**/*.tests.ts\"",
    "lint": "eslint .",
    "lint:updated": "pipe-git-updated --ext=cjs --ext=js --ext=mjs --ext=ts --base=4.x -- eslint",
    "prettier-check": "prettier -c \"**/*.{cjs,css,html,js,json,md,mjs,ts,yaml,yml}\"",
    "prettier-check:updated": "pipe-git-updated --ext=cjs --ext=css --ext=html --ext=js --ext=json --ext=md --ext=mjs --ext=ts --ext=yaml --ext=yml --base=4.x -- prettier -c",
    "prettify": "prettier --write \"**/*.{cjs,css,html,js,json,md,mjs,ts,yaml,yml}\"",
    "prettify:updated": "pipe-git-updated --ext=cjs --ext=css --ext=html --ext=js --ext=json --ext=md --ext=mjs --ext=ts --ext=yaml --ext=yml --base=4.x -- prettier --write",
    "test": "mocha --config test/mocha/config.json --parallel \"test/unit/**/*.test.ts\"",
    "test:ci": "npm run prettier-check:updated && npm run lint:updated && npm run test:isolated",
    "test:isolated": "mocha --config test/mocha/config.json --parallel \"test/unit/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0"
  },
  "license": "MIT"
}
